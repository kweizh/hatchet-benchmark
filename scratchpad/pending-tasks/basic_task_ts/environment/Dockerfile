FROM ubuntu:24.04

RUN apt-get update -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl wget ca-certificates git python3 python3-pip python3-pytest bash ripgrep && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g tsx typescript @hatchet-dev/typescript-sdk && \
    pip3 install --break-system-packages pytest-json-ctrf && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/user && chmod 0755 /home/user
RUN mkdir -p /home/user/myproject

LABEL Author="generate-harbor-tasks"
LABEL Description="Hatchet TypeScript basic-task environment with Node.js v20, tsx, and @hatchet-dev/typescript-sdk preinstalled."

CMD ["/bin/bash", "-c", "trap : TERM INT; sleep infinity & wait"]

# Container contents:
#   - always required apt packages: curl wget ca-certificates git python3 python3-pip python3-pytest bash ripgrep
#   - always required pip3 packages: pytest-json-ctrf
#   - Node.js v20 (via NodeSource) for running the Hatchet TypeScript SDK
#   - globally installed npm packages: tsx (TypeScript runner), typescript, @hatchet-dev/typescript-sdk
#   - /home/user/myproject: empty project directory where the agent creates worker.ts, runner.ts, package.json, and tsconfig.json
